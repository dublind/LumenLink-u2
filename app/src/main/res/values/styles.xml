<!-- Tema compartido: colores, tipografía, barras del sistema y ajuste al mostrar el teclado. -->
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#087F8C</item>
        <item name="android:statusBarColor">#102C40</item>
        <item name="android:navigationBarColor">#102C40</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowBackground">#F2F6F8</item>
    </style>
</resources>
